# EagleVision ANPR — Environment Configuration

# ============================================================================
# CORS Configuration (REQUIRED for production)
# ============================================================================
# Comma-separated list of allowed origins
# Example: https://app.yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Security Settings
# ============================================================================
# Maximum video file size in MB (default: 500)
MAX_VIDEO_SIZE_MB=500

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=sqlite:///./eaglevision_anpr.db

# ============================================================================
# Redis/Celery (Optional - for background processing)
# ============================================================================
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# API Configuration
# ============================================================================
# API_HOST=0.0.0.0
# API_PORT=8000
# API_WORKERS=4

# ============================================================================
# Logging
# ============================================================================
# LOG_LEVEL=INFO
# LOG_FILE=logs/eaglevision.log

# ============================================================================
# AI Investigation (NVIDIA Nemotron via Nebius Token Factory)
# ============================================================================
# Get your API key from: https://tokenfactory.nebius.com/
NEBIUS_API_KEY=
# Available models: nvidia/Llama-3.1-Nemotron-70B-Instruct-HF, nvidia/Nemotron-4-340B-Instruct
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
